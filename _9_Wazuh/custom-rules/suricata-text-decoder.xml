<decoder name="team4-suricata-text">
  <prematch type="pcre2">^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3} suricata_alert src_ip=</prematch>
  <regex type="pcre2">^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3} suricata_alert src_ip=([^\s]+) sid=[^\s]+ signature=.+$</regex>
  <order>srcip</order>
</decoder>
